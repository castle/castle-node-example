extends demo

block ui
  .field
    label email
    input.input(type="text" value=username disabled)
  .field
    label(for="password") new password
    input.input(type="password" id="password")
  .btn-row
    button.btn.btn-primary(onclick="resetPassword()") Submit

block desc
  p This demo records the password-reset event with the non-blocking 
    code /log
    |  endpoint, which stores the event without returning a verdict.
  p Assume the user already passed your reset challenge (e.g. an emailed OTP). Enter a value 
    em different from
    |  the valid password to send 
    code $password_reset / $succeeded
    | , or the valid password to send 
    code $password_reset / $failed
    | . (The password is not actually changed.)

block scripts
  script.
    function resetPassword() {
      withRequestToken(function (requestToken) {
        postJSON("/evaluate_new_password", {
          password: document.getElementById("password").value,
          request_token: requestToken,
        }).then(function (data) {
          renderCastleResponse(data);
          document.getElementById("desc").innerHTML =
            "<p>Logged <code>" + data.type + " / " + data.status +
            "</code> via the <code>/log</code> endpoint.</p>";
        });
      });
    }
