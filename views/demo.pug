extends base

block content
  if home
    section.hero
      span.tag castle node sdk 3.0
      h1(class="text-[2.2rem] mt-3") Castle workflows demo
      p(class="text-[1.15rem] text-muted") A small Express app showing how to integrate the Castle Node SDK.

    .grid.gap-4.mt-8(style="grid-template-columns:repeat(auto-fit,minmax(210px,1fr));")
      each demo in demo_list
        a.feature(href="/" + demo.url)
          h3= demo.friendly_name
          p= demo.blurb
  else
    .grid.gap-6.items-start(class="md:grid-cols-[1.3fr_1fr]")
      div
        .card
          .eyebrow workflow
          h2(class="text-[1.15rem]")= friendly_name

          #ui
            block ui

          #desc.text-muted(style="margin-top:1.2rem;")
            block desc

          if wsd
            hr.my-5.border-border
            a(href=wsd target="_blank" rel="noopener") View the web sequence diagram &rarr;

        #results-card.card.hidden.mt-6
          .eyebrow result
          #results

      aside
        .card
          .eyebrow session
          ul.meta-list
            li
              span.k publishable key
              span.v= castle_pk || '—'
            li
              span.k valid username
              span.v= valid_username
            li
              span.k valid password
              span.v= valid_password
