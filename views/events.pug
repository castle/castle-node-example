extends demo

block ui
  .btn-row(style="margin-top:0;")
    button(onclick="eventsSchema()") Fetch schema

  hr

  .field
    label(for="field") field
    input(type="text" id="field" value="name")
  .field
    label(for="op") op
    input(type="text" id="op" value="$eq")
  .field
    label(for="value") value
    input(type="text" id="value" value="$login")
  .btn-row
    button.primary(onclick="queryEvents()") Query events

block desc
  p The 
    strong Events
    |  API lets you inspect your event schema (
    code /events/schema
    | ) and query recorded events (
    code /events/query
    | ).
  p A valid Castle API secret is required for these calls to succeed.

block scripts
  script.
    function eventsSchema() {
      postJSON("/events_schema", {}).then(renderCastleResponse);
    }

    function queryEvents() {
      postJSON("/query_events", {
        field: document.getElementById("field").value,
        op: document.getElementById("op").value,
        value: document.getElementById("value").value,
      }).then(renderCastleResponse);
    }
